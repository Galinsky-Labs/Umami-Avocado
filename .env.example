# Local development only. Never commit actual credentials.
DATABASE_URL=postgresql://umami:umami_local_only@localhost:5432/umami
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_local_only
S3_SECRET_KEY=minio_local_only
APP_ENV=development
# One-time first-owner bootstrap secret (>=32 chars); generate with: openssl rand -hex 32
UMAMI_BOOTSTRAP_TOKEN=
CORS_ALLOW_ORIGINS=http://localhost:5173
LAB_LIVE_SUBMISSION_ENABLED=false
LAB_MAX_AUTHORIZED_SPEND_USD=0
